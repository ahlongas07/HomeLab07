# HomeLab07 Backup & Recovery example configuration.
# Copy to ../HomeLab07.private/env/backup.env and replace placeholders.
# Never commit the real configuration or Restic password.

# Restic supports local paths and remote backend URLs. For disaster recovery,
# use a separate physical device, host or remote backend.
RESTIC_REPOSITORY=/path/to/external/restic-repository

# Owner-readable file containing only the Restic repository password.
RESTIC_PASSWORD_FILE=/path/to/HomeLab07.private/secrets/restic-password

# Owner-only temporary workspace. It must not be inside a production data root.
HOMELAB07_BACKUP_STAGING_ROOT=/path/to/private/backup-staging

# Retention policy. Applied only by backup-retention.sh.
HOMELAB07_BACKUP_KEEP_DAILY=7
HOMELAB07_BACKUP_KEEP_WEEKLY=4
HOMELAB07_BACKUP_KEEP_MONTHLY=6
HOMELAB07_BACKUP_KEEP_YEARLY=1
