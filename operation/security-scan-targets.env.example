# Copy to HomeLab07.private/env/security-scan-targets/<target-id>.env, one file
# per application, and replace placeholders. The file name is the target ID: a
# lowercase identifier used in report paths and metric labels.
# Never commit the private file or real repository paths.

# Root of the application's Git work tree. A full clone is required: Gitleaks
# scans all refs and the complete history.
HOMELAB07_SECURITY_TARGET_REPOSITORY=/path/to/application/repository

# Compose definitions, relative to the repository, discovered on every run.
# Services added under this pattern are scanned without changing HomeLab07.
HOMELAB07_SECURITY_TARGET_COMPOSE_PATTERN=services/*/compose.yaml

# Optional. Directory holding <service>.env files used only to render the
# application's Compose definitions. It must stay outside the repository.
HOMELAB07_SECURITY_TARGET_ENV_ROOT=/path/to/application/private/env
