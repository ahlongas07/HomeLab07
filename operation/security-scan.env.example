# Copy to HomeLab07.private/env/security-scan.env and replace placeholders.
# Never commit the private file or real storage paths.

HOMELAB07_SECURITY_REPORT_ROOT=/path/to/mounted/vulnerability-management
HOMELAB07_TRIVY_CACHE_ROOT=/path/to/local/trivy-cache

# Keep the reviewed patch release and immutable registry manifest digest.
HOMELAB07_TRIVY_IMAGE=docker.io/aquasec/trivy:0.72.0@sha256:cffe3f5161a47a6823fbd23d985795b3ed72a4c806da4c4df16266c02accdd6f

# Full Git history scanner. Findings remain only on the private report share.
HOMELAB07_GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

# Sprint 012 is intentionally report-only.
HOMELAB07_SECURITY_SCAN_SEVERITIES=HIGH,CRITICAL
HOMELAB07_SECURITY_SCAN_TIMEOUT=20m
HOMELAB07_SECURITY_REPORT_REQUIRE_MOUNT=true
