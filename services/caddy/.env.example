# HomeLab07 Caddy example configuration.
# Copy this file to:
#   ../HomeLab07.private/env/caddy.env
#
# Never commit the real .env file.

# Absolute mount path for the Rockstor share named homelab07-data.
HOMELAB07_DATA_ROOT=/path/to/homelab07-data

# Non-root UID/GID that owns ${HOMELAB07_DATA_ROOT}/caddy/{data,config,logs}.
CADDY_UID=1000
CADDY_GID=1000

# Contact address for the ACME account (certificate expiry notices).
CADDY_ACME_EMAIL=operator@example.invalid

# Public route domains. Each one must be proxied by Cloudflare.
CADDY_LANDING_PAGE_DOMAIN=www.example.invalid
CADDY_NEXTCLOUD_DOMAIN=cloud.example.invalid
CADDY_PAPERLESS_DOMAIN=documents.example.invalid
CADDY_JELLYFIN_DOMAIN=media.example.invalid
CADDY_KEYCLOAK_DOMAIN=identity.example.invalid
