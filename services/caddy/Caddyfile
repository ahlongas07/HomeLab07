# HomeLab07 shared reverse proxy.
#
# Domains and the ACME contact come from the private environment, and the
# Cloudflare ranges from cloudflare-ranges.env. Every route lives in sites/.
{
	email {$CADDY_ACME_EMAIL}
	# Loopback inside the container only: unreachable from other containers.
	admin localhost:2019
	# Plain HTTP is served by the http:// block below, which applies the
	# Cloudflare source check before redirecting.
	auto_https disable_redirects
	servers {
		# Keep Cloudflare's forwarded headers.
		trusted_proxies static {$CLOUDFLARE_RANGES}
		# The visitor address comes from the header Cloudflare always sets.
		client_ip_headers CF-Connecting-IP
	}
}

import snippets/*.caddy
import sites/*.caddy

# Plain HTTP on every host: only Cloudflare sources are redirected to HTTPS,
# matched on the connecting address; any other source receives 403. ACME
# HTTP-01 challenges are answered by Caddy before this block.
http:// {
	@cloudflare remote_ip {$CLOUDFLARE_RANGES}
	redir @cloudflare https://{host}{uri} 308
	respond 403
}
