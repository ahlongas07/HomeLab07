# Copy to ../HomeLab07.private/env/paperless-quote-sync.env, set mode 600 and
# replace placeholders. Never commit the real environment file.
#
# This file is used twice: as Compose interpolation (paths, UID, limits) and as
# the container env_file (runtime values and the secret).

# --- Compose interpolation ----------------------------------------------------
# NAS folder where the JuanchoAI API writes the final quote PDFs, one
# subfolder per year. Mounted read-only; the same path is mounted read-write in
# the JuanchoAI API. Owned by the platform operator user and group, mode 750.
QUOTES_SOURCE_ROOT=/path/to/quotes
# Same host path as HOMELAB07_OBSERVABILITY_METRICS_ROOT; writable by QUOTE_SYNC_UID.
QUOTE_SYNC_METRICS_ROOT=/path/to/homelab07-observability/metrics
# Platform operator UID/GID: can read QUOTES_SOURCE_ROOT and write the metrics.
QUOTE_SYNC_UID=1000
QUOTE_SYNC_GID=1000
QUOTE_SYNC_MEMORY_LIMIT=128m

# --- Runtime ------------------------------------------------------------------
PAPERLESS_INTERNAL_URL=http://homelab07-paperless-ngx:8000
# Same value as PAPERLESS_TIME_ZONE.
TZ=Region/City
# Daily fallback run.
QUOTE_SYNC_HOUR=3
# Poll the quotes folder every QUOTE_WATCH_INTERVAL seconds (0 = daily run only)
# and sync once a change has been stable for QUOTE_SETTLE_SECONDS.
QUOTE_WATCH_INTERVAL=30
QUOTE_SETTLE_SECONDS=10
# Next attempt while Paperless is unreachable, a run failed or an upload is unconfirmed.
QUOTE_RETRY_SECONDS=120
QUOTE_STARTUP_WAIT=600
# Seconds to wait for an upload to appear in the Work Item search.
QUOTE_CONFIRM_TIMEOUT=300
# Uploads of the same file content before it is reported as failure.
QUOTE_MAX_ATTEMPTS=3
# Heartbeat metric refresh while waiting for changes.
QUOTE_HEARTBEAT_SECONDS=300

# --- Secret -------------------------------------------------------------------
# API token of the juanchoai Paperless user (the same token the JuanchoAI API uses).
PAPERLESS_QUOTE_TOKEN=replace-with-juanchoai-token
