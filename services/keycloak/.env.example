# HomeLab07 Keycloak example configuration.
# Copy to ../HomeLab07.private/env/keycloak.env and replace placeholders.

KEYCLOAK_DB_HOST=homelab07-mariadb
KEYCLOAK_DB_PORT=3306
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-strong-database-password
KEYCLOAK_HOSTNAME=identity.example.invalid
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=homelab07-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-one-time-bootstrap-password

