# HomeLab07 Observability example configuration.
# Copy to ../HomeLab07.private/env/observability.env and replace placeholders.

# Every runtime image must use a readable patch tag and immutable digest.
ALLOY_IMAGE=docker.io/grafana/alloy:replace-with-reviewed-version@sha256:replace-with-64-lowercase-hex-characters
PROMETHEUS_IMAGE=docker.io/prom/prometheus:replace-with-reviewed-version@sha256:replace-with-64-lowercase-hex-characters
LOKI_IMAGE=docker.io/grafana/loki:replace-with-reviewed-version@sha256:replace-with-64-lowercase-hex-characters
GRAFANA_IMAGE=docker.io/grafana/grafana:replace-with-reviewed-version@sha256:replace-with-64-lowercase-hex-characters

# Dedicated persistent runtime root. Metrics and logs are disposable and are
# excluded from platform backup; repository configuration is authoritative.
HOMELAB07_OBSERVABILITY_ROOT=/absolute/path/to/observability

# Host-side textfile directory, mounted read-only into Alloy.
HOMELAB07_OBSERVABILITY_METRICS_ROOT=/absolute/path/to/observability-metrics

# Restricted Nginx Proxy Manager log root approved for ingestion.
HOMELAB07_NPM_LOG_ROOT=/absolute/path/to/nginx-proxy-manager/logs

# Private blackbox target file copied from operation/probe-targets.example.yaml.
HOMELAB07_OBSERVABILITY_PROBE_TARGETS_FILE=/absolute/path/to/probe-targets.yaml

# Private Rockstor inventory copied from operation/storage-metrics.example.tsv.
HOMELAB07_STORAGE_INVENTORY_FILE=/absolute/path/to/storage-metrics.tsv

# Explicit LAN host address. Wildcard addresses are rejected by preflight.
GRAFANA_LAN_BIND_ADDRESS=replace-with-private-lan-ip
GRAFANA_LAN_PORT=3000

GRAFANA_ADMIN_USER=homelab07-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-emergency-password

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=168h
