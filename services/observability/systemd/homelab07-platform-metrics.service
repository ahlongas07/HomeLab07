[Unit]
Description=HomeLab07 platform textfile metrics
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/homelab07/observability-runtime.env
ExecStart=/usr/bin/env bash -c 'exec "${HOMELAB07_PROJECT_ROOT}/operation/platform-metrics.sh"'
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
