# Copy to ../HomeLab07.private/env/paperless-medical-sync.env, set mode 600 and
# replace placeholders. Never commit the real environment file.
#
# This file is used twice: as Compose interpolation (paths, UID, limits) and as
# the container env_file (runtime values and secrets). Keep JSON values in
# single quotes so they are taken literally; values must not contain a single
# quote.

# --- Compose interpolation ----------------------------------------------------
# Host folder with the original exams. Mounted read-only.
SYNC_SOURCE_ROOT=/path/to/medical-exams
# Same host path as HOMELAB07_OBSERVABILITY_METRICS_ROOT; writable by SYNC_UID.
SYNC_METRICS_ROOT=/path/to/homelab07-observability/metrics
# UID/GID that can read SYNC_SOURCE_ROOT and write SYNC_METRICS_ROOT.
SYNC_UID=1000
SYNC_GID=1000
SYNC_MEMORY_LIMIT=256m
# Must hold the largest decrypted PDF; counts against SYNC_MEMORY_LIMIT.
SYNC_TMPFS_SIZE=128m

# --- Runtime ------------------------------------------------------------------
PAPERLESS_INTERNAL_URL=http://homelab07-paperless-ngx:8000
# Same value as PAPERLESS_TIME_ZONE.
TZ=Region/City
SYNC_HOUR=3
# Poll the source folder every SYNC_WATCH_INTERVAL seconds (0 = daily run only)
# and sync once a change has been stable for SYNC_SETTLE_SECONDS.
SYNC_WATCH_INTERVAL=30
SYNC_SETTLE_SECONDS=30
SYNC_RETRY_SECONDS=3600
SYNC_STARTUP_WAIT=600
SYNC_TASK_TIMEOUT=900
# Paperless user that owns every exam (model-init only).
SYNC_OWNER_USERNAME=replace-with-owner-username
# Existing Paperless users that may only read exams, for example an agent
# account (model-init only). JSON list; empty means none. They must exist first.
SYNC_READER_USERNAMES='[]'

# Normalized folder name -> category tag. Matching ignores case and accents.
# Replace with the real folders before the first load and check with preview.
SYNC_CATEGORY_MAP='{"laboratorio":"Laboratorio","ecografia":"Ecografía","audiometria":"Audiometría"}'

# Case-insensitive regular expressions removed from titles and masked in logs.
# Include labels such as "CC" in the pattern and allow "_", "-" or spaces.
# Replace with real values before the first load and check with preview.
SYNC_PERSONAL_PATTERNS='["holder[ _-]*name","\\bCC[ _-]*\\d{6,}","\\b1234567890\\b"]'

# --- Secrets ------------------------------------------------------------------
PAPERLESS_SYNC_TOKEN=replace-with-sync-medico-token
PDF_PASSWORDS='["replace-with-pdf-password"]'
